row function directly:"},"846":{"id":"/use/commands/filters-21","page_id":"/use/commands/filters","tags":[],"type":"text","url":"/use/commands/filters#cooldown-filter","content":"A simple cooldown filter that prevents a command from being executed too frequently, while also cleaning up expired cooldowns every minute:"},"847":{"id":"/use/commands/filters-22","page_id":"/use/commands/filters","tags":[],"type":"text","url":"/use/commands/filters#permission-filter","content":"A permission filter that checks if a member has the required permissions to execute a command:"},"848":{"id":"/use/commands","page_id":"/use/commands","type":"page","content":"Commands Overview","breadcrumbs":["Docs","Use","Commands"],"tags":[],"url":"/use/commands"},"849":{"id":"/use/commands-0","page_id":"/use/commands","type":"heading","tags":[],"url":"/use/commands#quick-example","content":"Quick example"},"850":{"id":"/use/commands-1","page_id":"/use/commands","type":"heading","tags":[],"url":"/use/commands#command-deployment","content":"Command deployment"},"851":{"id":"/use/commands-2","page_id":"/use/commands","type":"heading","tags":[],"url":"/use/commands#add-or-deploy-first","content":"Add or deploy first?"},"852":{"id":"/use/commands-3","page_id":"/use/commands","type":"heading","tags":[],"url":"/use/commands#command-types","content":"Command types"},"853":{"id":"/use/commands-4","page_id":"/use/commands","tags":[],"type":"text","url":"/use/commands","content":"Commands are how your bot responds to user interactions."},"854":{"id":"/use/commands-5","page_id":"/use/commands","tags":[],"type":"text","url":"/use/commands","content":"Nyx **only** supports application commands. It doesn't and won't support message content commands (like `!ping`)."},"855":{"id":"/use/commands-6","page_id":"/use/commands","tags":[],"type":"text","url":"/use/commands","content":"If you really need such functionality, you can implement it yourself using the `messageCreate` event, but this isn't advised. Application commands improve DX and UX significantly, and don't require a privileged intent to work."},"856":{"id":"/use/commands-7","page_id":"/use/commands","tags":[],"type":"text","url":"/use/commands#quick-example","content":"Let's create a simple ping command:"},"857":{"id":"/use/commands-8","page_id":"/use/commands","tags":[],"type":"text","url":"/use/commands#quick-example","content":"That's it! Your bot now has a `/ping` command that replies with \"Pong!\" when used."},"858":{"id":"/use/commands-9","page_id":"/use/commands","tags":[],"type":"text","url":"/use/commands#quick-example","content":"The framework doesn't store any state in the instance, so you can reuse it across multiple bot instances without any problems."},"859":{"id":"/use/commands-10","page_id":"/use/commands","tags":[],"type":"text","url":"/use/commands#command-deployment","content":"For commands to be deployed at Discord, you must either pass `deployCommands: true` when creating the bot, or deploy them manually."},"860":{"id":"/use/commands-11","page_id":"/use/commands","tags":[],"type":"text","url":"/use/commands#command-deployment","content":"Then, when starting the bot, it will automatically deploy them."},"861":{"id":"/use/commands-12","page_id":"/use/commands","tags":[],"type":"text","url":"/use/commands#command-deployment","content":"You can also deploy manually:"},"862":{"id":"/use/commands-13","page_id":"/use/commands","tags":[],"type":"text","url":"/use/commands#command-deployment","content":"<Callout type=\"error\">This will throw if you passed `deployCommands: true` or already called it before.</Callout>"},"863":{"id":"/use/commands-14","page_id":"/use/commands","tags":[],"type":"text","url":"/use/commands#add-or-deploy-first","content":"If you add a command after commands have already been deployed, the framework will have to make an API call to register it."},"864":{"id":"/use/commands-15","page_id":"/use/commands","tags":[],"type":"text","url":"/use/commands#add-or-deploy-first","cont
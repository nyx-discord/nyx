{
  "name": "@nyx-discord/framework",
  "version": "3.0.0-beta.0",
  "description": "The default implementation of nyx framework.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "./dist/index.mjs",
  "files": [
    "dist/**",
    "assets/**"
  ],
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nyx-discord/nyx.git"
  },
  "scripts": {
    "lint": "eslint ./src",
    "format": "prettier --write ./src",
    "barrel": "node ../../scripts/barrel.mjs --directory ./src --delete --singleQuotes --append \"export * from '@nyx-discord/core';\"",
    "build": "rimraf dist && tsup-node src/index.ts",
    "prepublishOnly": "pnpm run build",
    "test": "vitest --run",
    "coverage": "vitest run --coverage"
  },
  "keywords": [
    "discord",
    "bot",
    "discord.js",
    "framework"
  ],
  "license": "MIT",
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typedoc-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*"
  },
  "peerDependencies": {
    "discord.js": "^14.22.1"
  },
  "dependencies": {
    "@nyx-discord/core": "workspace:*",
    "@sapphire/string-store": "3.0.0",
    "cron": "3.0.0",
    "typed-field": "1.2.0"
  }
}

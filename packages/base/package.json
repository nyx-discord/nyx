{
  "name": "@nyx-discord/base",
  "version": "1.0.0",
  "description": "The default implementations of nyx, decoupled from any Discord library.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.mjs",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nyx-discord/nyx.git"
  },
  "exports": {
    ".": {
      "require": {
        "@nyx-discord/base": "./src/index.ts",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "import": {
        "@nyx-discord/base": "./src/index.ts",
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "files": [
    "dist/**",
    "assets/**"
  ],
  "scripts": {
    "lint": "eslint ./src",
    "lint:fix": "eslint --fix ./src",
    "format:check": "prettier --check ./src",
    "format": "prettier --write ./src",
    "barrel": "node ../../scripts/barrel.mjs --directory ./src --delete --singleQuotes --append \"export * from '@nyx-discord/types';\"",
    "build": "rimraf dist && tsup-node src/index.ts && prettier --write dist/*.d.ts dist/*.d.mts",
    "prepublishOnly": "pnpm run build",
    "test": "vitest --run",
    "coverage": "vitest run --coverage"
  },
  "keywords": [
    "discord",
    "bot",
    "discord.js",
    "framework"
  ],
  "license": "MIT",
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typedoc-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*"
  },
  "dependencies": {
    "@discordjs/collection": "1.5.3",
    "@nyx-discord/types": "workspace:*",
    "@sapphire/string-store": "3.0.0",
    "cron": "4.4.0",
    "discord-api-types": "^0.38.50"
  }
}

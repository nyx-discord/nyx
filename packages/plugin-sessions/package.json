{
  "name": "@nyx-discord/plugin-sessions",
  "version": "2.0.0",
  "description": "A nyx plugin to manage user interaction sessions in your bot.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.mjs",
  "files": [
    "dist/**",
    "assets/**"
  ],
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nyx-discord/nyx.git"
  },
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./djs": {
      "require": {
        "types": "./dist/djs/index.d.ts",
        "default": "./dist/djs/index.js"
      },
      "import": {
        "types": "./dist/djs/index.d.mts",
        "default": "./dist/djs/index.mjs"
      }
    },
    "./djs-core": {
      "require": {
        "types": "./dist/djs-core/index.d.ts",
        "default": "./dist/djs-core/index.js"
      },
      "import": {
        "types": "./dist/djs-core/index.d.mts",
        "default": "./dist/djs-core/index.mjs"
      }
    },
    "./shared": {
      "require": {
        "types": "./dist/shared/index.d.ts",
        "default": "./dist/shared/index.js"
      },
      "import": {
        "types": "./dist/shared/index.d.mts",
        "default": "./dist/shared/index.mjs"
      }
    }
  },
  "scripts": {
    "lint": "eslint ./src",
    "lint:fix": "eslint --fix ./src",
    "format:check": "prettier --check ./src",
    "format": "prettier --write ./src",
    "barrel": "node ../../scripts/barrel.mjs --directory ./src/shared --delete --singleQuotes && node ../../scripts/barrel.mjs --directory ./src/djs --delete --singleQuotes --append \"export * from '../shared/index.js';\" && node ../../scripts/barrel.mjs --directory ./src/djs-core --delete --singleQuotes --append \"export * from '../shared/index.js';\"",
    "build": "rimraf dist && tsup-node src/index.ts src/shared/index.ts src/djs/index.ts src/djs-core/index.ts && prettier --write dist/**/*.d.ts dist/**/*.d.mts",
    "prepublishOnly": "pnpm run build",
    "test": "vitest --run",
    "coverage": "vitest run --coverage"
  },
  "keywords": [
    "discord",
    "bot",
    "discord.js",
    "framework"
  ],
  "license": "MIT",
  "devDependencies": {
    "@discordjs/core": "^2.6.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/typedoc-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "discord.js": "14.22.1"
  },
  "peerDependencies": {
    "@discordjs/core": "^2.6.0",
    "discord.js": "^14.22.1"
  },
  "peerDependenciesMeta": {
    "@discordjs/core": {
      "optional": true
    },
    "discord.js": {
      "optional": true
    }
  },
  "dependencies": {
    "@discordjs/collection": "1.5.3",
    "@isaacs/ttlcache": "1.4.1",
    "@nyx-discord/base": "workspace:*",
    "@nyx-discord/djs": "workspace:*",
    "@nyx-discord/djs-core": "workspace:*",
    "@nyx-discord/types": "workspace:*",
    "@sapphire/string-store": "3.0.0",
    "discord-api-types": "^0.38.50"
  }
}

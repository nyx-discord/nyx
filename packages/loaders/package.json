{
  "name": "@nyx-discord/loaders",
  "version": "1.0.0",
  "description": "Directory-scanning loaders for nyx commands, events, and schedules.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "./dist/index.mjs",
  "files": [
    "dist/**"
  ],
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nyx-discord/nyx.git"
  },
  "scripts": {
    "lint": "eslint ./src",
    "lint:fix": "eslint --fix ./src",
    "format:check": "prettier --check ./src",
    "format": "prettier --write ./src",
    "barrel": "barrelsby --directory ./src --delete --singleQuotes",
    "build": "rimraf dist && tsup-node src/index.ts",
    "prepublishOnly": "pnpm run build",
    "test": "vitest --run",
    "coverage": "vitest run --coverage"
  },
  "keywords": [
    "discord",
    "bot",
    "discord.js",
    "framework",
    "loader"
  ],
  "license": "MIT",
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typedoc-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*"
  },
  "peerDependencies": {
    "@nyx-discord/base": "workspace:*"
  },
  "dependencies": {
    "@nyx-discord/base": "workspace:*",
    "@nyx-discord/types": "workspace:*"
  }
}

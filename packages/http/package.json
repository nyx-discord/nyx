{
  "name": "@nyx-discord/http",
  "version": "1.0.0",
  "description": "Receive Discord interactions and webhook events over HTTP with any server or runtime, using the @discordjs/core adapter.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.mjs",
  "files": [
    "dist/**"
  ],
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nyx-discord/nyx.git"
  },
  "exports": {
    ".": {
      "require": {
        "@nyx-discord/http": "./src/index.ts",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "import": {
        "@nyx-discord/http": "./src/index.ts",
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "lint": "eslint ./src",
    "lint:fix": "eslint --fix ./src",
    "format:check": "prettier --check ./src",
    "format": "prettier --write ./src",
    "barrel": "node ../../scripts/barrel.mjs --directory ./src --delete --singleQuotes --append \"export { HttpBot as Bot } from './bot/HttpBot'; export { TypedFields } from './fields/TypedFields'; export * from '@nyx-discord/djs-core';\" && prettier --write src/index.ts",
    "build": "rimraf dist && tsup-node src/index.ts && prettier --write dist/*.d.ts dist/*.d.mts",
    "prepublishOnly": "pnpm run build",
    "test": "vitest --run",
    "coverage": "vitest run --coverage"
  },
  "keywords": [
    "discord",
    "bot",
    "framework",
    "interactions",
    "http",
    "serverless"
  ],
  "license": "MIT",
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typedoc-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*"
  },
  "dependencies": {
    "@discordjs/core": "^2.6.0",
    "@discordjs/rest": "^2.6.3",
    "@nyx-discord/djs-core": "workspace:^"
  }
}

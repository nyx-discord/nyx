{
  "$schema": "node_modules/lerna/schemas/lerna-schema.json",
  "version": "independent",
  "npmClient": "pnpm",
  "changelog": true,
  "commitHooks": true,
  "ignoreChanges": [
    "configs/**",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.spec.ts"
  ],
  "changelogPreset": {
    "name": "conventional-changelog-conventionalcommits",
    "types": [
      {
        "type": "feat",
        "section": "Features"
      },
      {
        "type": "feature",
        "section": "Features"
      },
      {
        "type": "fix",
        "section": "Bug Fixes"
      },
      {
        "type": "perf",
        "section": "Performance Improvements"
      },
      {
        "type": "revert",
        "section": "Reverts"
      },
      {
        "type": "docs",
        "section": "Documentation",
        "effect": "changelog"
      },
      {
        "type": "style",
        "section": "Code Style",
        "effect": "changelog"
      },
      {
        "type": "chore",
        "section": "Miscellaneous",
        "effect": "changelog"
      },
      {
        "type": "refactor",
        "section": "Code Refactoring",
        "effect": "changelog"
      },
      {
        "type": "test",
        "section": "Tests",
        "effect": "hidden"
      },
      {
        "type": "build",
        "section": "Build System",
        "effect": "hidden"
      },
      {
        "type": "ci",
        "section": "Continuous Integration",
        "effect": "hidden"
      }
    ]
  }
}
